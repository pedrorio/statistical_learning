\documentclass{article}
\usepackage{booktabs,longtable,graphicx,array}
\usepackage[margin=0.75in]{geometry}
\begin{document}

<<setup, include=FALSE>>=
knitr::opts_knit$set(root.dir = normalizePath(".."))
knitr::opts_chunk$set(
  echo = FALSE,
  message = FALSE,
  warning = FALSE,
  fig.path = "build/figures/reeval-",
  fig.width = 7,
  fig.height = 3.4
)
@

<<load, include=FALSE>>=
library(dplyr)
library(ggplot2)
library(kableExtra)
results_dir <- "results/reevaluation"
original <- readRDS(file.path(results_dir, "metrics.rds"))
added <- readRDS(file.path(results_dir, "metrics_added.rds"))
pr_original <- readRDS(file.path(results_dir, "metrics_pr_original.rds"))
baseline <- readRDS(file.path(results_dir, "baseline.rds"))
run <- readRDS(file.path(results_dir, "run.rds"))
run_added <- readRDS(file.path(results_dir, "run_added.rds"))
run_pr <- readRDS(file.path(results_dir, "run_pr_original.rds"))
if (nrow(pr_original) != 105 || any(pr_original$pr_status != "ok")) {
  stop("Original average precision was not reproduced for every fit")
}
original$cohort <- "original"
original <- original %>%
  left_join(
    dplyr::select(pr_original, model, arm, seed, pr_auc, pr_status),
    by = c("model", "arm", "seed")
  )
if (any(is.na(original$pr_auc))) stop("An original fit is missing average precision")
original$pred_saved <- TRUE
if (!"precision" %in% names(original)) original$precision <- NA_real_
if (!"recall" %in% names(original)) original$recall <- NA_real_
added$cohort <- "added"
added$pr_status <- "ok"
metrics <- bind_rows(original, added)
if (nrow(metrics) != 140) stop("Expected 140 fits")
metrics <- metrics %>%
  mutate(
    precision_show = if_else(!is.na(precision), precision, if_else(tp + fp > 0, tp / (tp + fp), NA_real_)),
    recall_show = if_else(!is.na(recall), recall, if_else(tp + fn > 0, tp / (tp + fn), NA_real_))
  )
baseline$cohort <- "baseline"
baseline$pred_saved <- FALSE
baseline$precision_show <- NA_real_
baseline$recall_show <- 0
scores <- bind_rows(metrics, baseline)
arm_label <- c(
  rose = "ROSE",
  weights = "Class weights",
  none = "No resampling",
  score = "Score",
  baseline = "Baseline"
)
fmt <- function(x) ifelse(is.finite(x), sprintf("%.3f", x), "NA")
label_arm <- function(arm) {
  out <- unname(arm_label[as.character(arm)])
  if (anyNA(out)) stop("Unknown arm")
  out
}
by_arm <- metrics %>%
  group_by(model, model_name, arm, cohort) %>%
  summarise(
    ok = all(status == "ok"),
    unsupported = all(status == "unsupported"),
    beats = all(status == "ok") && all(bal_accuracy > 0.5),
    mean_ba = mean(bal_accuracy),
    sd_ba = sd(bal_accuracy),
    min_ba = min(bal_accuracy),
    mean_auc = mean(roc_auc),
    mean_pr = mean(pr_auc),
    mean_acc = mean(accuracy),
    mean_precision = mean(precision_show),
    mean_recall = mean(recall_show),
    pred_saved = all(pred_saved %in% TRUE),
    tp = mean(tp),
    fp = mean(fp),
    tn = mean(tn),
    fn = mean(fn),
    .groups = "drop"
  ) %>%
  arrange(desc(mean_ba))
guess_row <- baseline %>%
  mutate(pr_auc = run_pr$guess_low_pr_auc) %>%
  group_by(model, model_name, arm) %>%
  summarise(
    cohort = "baseline",
    ok = TRUE,
    unsupported = FALSE,
    beats = FALSE,
    mean_ba = mean(bal_accuracy),
    sd_ba = sd(bal_accuracy),
    min_ba = min(bal_accuracy),
    mean_auc = mean(roc_auc),
    mean_pr = mean(pr_auc),
    mean_acc = mean(accuracy),
    mean_precision = NA_real_,
    mean_recall = 0,
    pred_saved = TRUE,
    tp = mean(tp),
    fp = mean(fp),
    tn = mean(tn),
    fn = mean(fn),
    .groups = "drop"
  )
by_arm <- bind_rows(by_arm, guess_row)
show_num <- function(unsupported, value) {
  ifelse(unsupported, "unsupported", fmt(value))
}
failed <- metrics %>% filter(status != "ok")
@

<<results, results="asis">>=
hours <- run$wall_seconds / 3600
added_hours <- run_added$wall_seconds / 3600
cat(sprintf(
  "This note is a re-evaluation of the red-wine classifiers. It is not the graded conclusion, and the numbers below are not Table 3.1.\n\nFive stratified 80/20 splits, seeds %s, each scored once. Grid points are chosen by %d by %d cross-validated balanced accuracy, with high quality as the event. A row beats guessing low only when every split does. The original fit took %.2f hours on %d cores.\n\nThe added LightGBM, fuller XGBoost, and score-model fits are %d outer jobs. That run took %.2f hours on %d cores. The planning estimate was 2.15 hours.\n\nAverage precision for the original 105 fits is one refit of each stored workflow on that seed's training split. The 10 by 10 was not run again. The refit took %.3f seconds on %d cores. %d of 105 matched the stored ROC AUC, balanced accuracy, accuracy, and confusion counts exactly on the first refit, and the other %d matched exactly on the original L'Ecuyer stream. None were left unreproduced.\n",
  paste(run$seeds, collapse = ", "),
  run$v,
  run$repeats,
  hours,
  run$cores,
  run_added$combinations,
  added_hours,
  run_added$cores,
  run_pr$wall_seconds,
  run_pr$cores,
  run_pr$first_exact,
  run_pr$lecuyer_matched
))
@

<<ba-table, results="asis">>=
shown <- by_arm %>%
  transmute(
    Model = model_name,
    Arm = label_arm(arm),
    Mean = show_num(unsupported, mean_ba),
    SD = show_num(unsupported, sd_ba),
    Min = show_num(unsupported, min_ba),
    ROC = show_num(unsupported, mean_auc),
    `PR AUC` = ifelse(unsupported, "unsupported", ifelse(pred_saved, fmt(mean_pr), "not saved")),
    Accuracy = show_num(unsupported, mean_acc),
    Precision = show_num(unsupported, mean_precision),
    Recall = show_num(unsupported, mean_recall),
    Beats = ifelse(beats, "yes", "no")
  )
knitr::kable(
  shown,
  format = "latex",
  booktabs = TRUE,
  caption = "Test metrics across the five splits. Means, and the balanced-accuracy SD and minimum. Average precision for the original fits is from the one-shot refit. Guess low has no ranking; its average precision is the constant-score value. Precision and recall for the original fits are from the saved confusion counts. High quality is the positive class."
) %>%
  kable_styling(font_size = 8, latex_options = "scale_down")
@

Table 3.1 in the graded report is test accuracy under that report's own split, metric, and recipes.

<<confusion, results="asis">>=
confusion <- by_arm %>%
  transmute(
    Model = model_name,
    Arm = label_arm(arm),
    TP = fmt(tp),
    FP = fmt(fp),
    TN = fmt(tn),
    FN = fmt(fn)
  )
knitr::kable(
  confusion,
  booktabs = TRUE,
  caption = "Mean test confusion counts. High quality is the positive class."
)
@

<<figure, fig.cap="Test balanced accuracy of the original models on each outer split. The line is guessing low.">>=
plot_scores <- scores %>% filter(cohort == "original")
ggplot(plot_scores, aes(seed, bal_accuracy, colour = model_name, group = model_name)) +
  geom_hline(yintercept = 0.5) +
  geom_line() +
  geom_point() +
  facet_wrap(~ arm, labeller = as_labeller(arm_label)) +
  scale_x_continuous(breaks = run$seeds) +
  labs(x = "Split seed", y = "Balanced accuracy", colour = NULL) +
  theme_bw() +
  theme(legend.position = "bottom")
@

<<figure-added, fig.cap="Test balanced accuracy of the added models on each outer split. The line is guessing low.">>=
plot_added <- scores %>% filter(cohort == "added", status == "ok")
ggplot(plot_added, aes(seed, bal_accuracy, colour = model_name, group = model_name)) +
  geom_hline(yintercept = 0.5) +
  geom_line() +
  geom_point() +
  facet_wrap(~ arm, labeller = as_labeller(arm_label)) +
  scale_x_continuous(breaks = run$seeds) +
  labs(x = "Split seed", y = "Balanced accuracy", colour = NULL) +
  theme_bw() +
  theme(legend.position = "bottom")
@

<<selected, results="asis">>=
selected <- metrics %>%
  transmute(
    Model = model_name,
    Arm = label_arm(arm),
    Seed = seed,
    Threshold = fmt(threshold),
    Parameters = ifelse(is.na(params), "", params)
  )
knitr::kable(
  selected,
  format = "latex",
  booktabs = TRUE,
  longtable = TRUE,
  caption = "Threshold and parameters chosen on each training split."
) %>%
  column_spec(1, width = "3.6cm") %>%
  column_spec(2, width = "2.6cm") %>%
  column_spec(5, width = "5.4cm")
@

<<failures, results="asis">>=
if (nrow(failed) == 0) {
  cat("Every model and arm produced a finite test score on every split.\n")
} else {
  cat("Some cells did not produce a score.\n")
  cat("\\begin{verbatim}\n")
  lines <- sprintf(
    "%s, %s, seed %s (%s): %s",
    failed$model_name, failed$arm, failed$seed, failed$status, failed$detail
  )
  cat(paste(lines, collapse = "\n"))
  cat("\n\\end{verbatim}\n")
}
@

The graded winsorise call passes \texttt{prob = 0.999} on a data frame. That method gives the extra arguments to \texttt{as.matrix}, so 0.999 never arrives. The transform that runs uses the multivariate default: median, MAD, a Huber correlation, and chi-square probability 0.95. This note freezes those statistics on the training predictors and does not read the label.

\end{document}
