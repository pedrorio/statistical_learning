<<gam-compare, results="asis">>=
compare <- data.frame(
  Model = c("Penalised GAM", "Penalised GAM", "Stack", "Simple average", "Radial SVM"),
  Arm = c("class weights", "no resampling", "out-of-fold blend", "out-of-fold mean", "no resampling"),
  `Balanced accuracy` = fmt(c(gam_weights_means[["ba"]], gam_none_means[["ba"]], stack_means[["ba"]], average_means[["ba"]], svm_means[["ba"]])),
  `ROC AUC` = fmt(c(gam_weights_means[["roc"]], gam_none_means[["roc"]], stack_means[["roc"]], average_means[["roc"]], svm_means[["roc"]])),
  `PR AUC` = fmt(c(gam_weights_means[["pr"]], gam_none_means[["pr"]], stack_means[["pr"]], average_means[["pr"]], svm_means[["pr"]])),
  check.names = FALSE,
  stringsAsFactors = FALSE
)
knitr::kable(
  compare,
  format = "latex",
  booktabs = TRUE,
  caption = "Mean test metrics over seeds 2021 to 2025. The stack and the average are scored once, at a cut-off chosen from their own out-of-fold predictions. The radial SVM row is the stored fit."
) %>%
  kable_styling(font_size = 9)
@

<<gam-verdict, results="asis">>=
cat(sprintf(
  "The 10 by 10 reruns passed the \\(10^{-9}\\) gate on %d of %d model-by-seed jobs, so %d of 5 seeds were stacked. Wall time was %.1f seconds on %d cores.\n\n",
  sum(rerun_rows$pass), nrow(rerun_rows), seeds_stacked, run_gs$wall_seconds, run_gs$cores
))
if (anyNA(decision$stack) || any(vapply(stack_fits, function(item) !identical(item$status, "ok"), logical(1)))) {
  cat("At least one seed is not reproducible, so the stack is not worth keeping.\n")
} else {
  pen_grid <- dials::grid_regular(dials::penalty(), levels = 25)
  penalties <- vapply(stack_fits, function(item) item$penalty[[1]], numeric(1))
  d_svm <- decision$stack - decision$svm
  d_avg <- decision$stack - decision$average
  cat(sprintf(
    "Paired gain in test balanced accuracy against the radial SVM: %s. Mean %+.4f, sample sd %.4f, %d of 5 strictly positive.\n\n",
    paste(sprintf("%+.4f", d_svm), collapse = ", "),
    mean(d_svm), stats::sd(d_svm), sum(d_svm > 0)
  ))
  cat(sprintf(
    "Paired gain against the simple average: %s. Mean %+.4f, sample sd %.4f, %d of 5 strictly positive.\n\n",
    paste(sprintf("%+.4f", d_avg), collapse = ", "),
    mean(d_avg), stats::sd(d_avg), sum(d_avg > 0)
  ))
  if (isTRUE(decision$keep)) {
    cat("The stack clears both references on the pre-registered rule, so it is kept.\n")
  } else {
    cat("The stack is not worth keeping. The numbers stay as evidence.\n\n")
  }
  if (length(unique(penalties)) == 1 && isTRUE(all.equal(penalties[[1]], min(pen_grid$penalty)))) {
    cat(sprintf(
      "The blender's penalty landed at the bottom of its grid (%.3g) on every seed, and the grid was deliberately not extended after seeing the result, because the drop rule was set in advance and the stack matches the simple average anyway.\n",
      penalties[[1]]
    ))
  } else {
    cat(sprintf(
      "Selected penalties: %s. The 25-point grid runs from %.3g to %.3g.\n",
      paste(sprintf("%.3g", penalties), collapse = ", "),
      min(pen_grid$penalty),
      max(pen_grid$penalty)
    ))
  }
}
@

The graded winsorise call passes \texttt{prob = 0.999} on a data frame. That method gives the extra arguments to \texttt{as.matrix}, so 0.999 never arrives. The transform that runs uses the multivariate default: median, MAD, a Huber correlation, and chi-square probability 0.95. This note freezes those statistics on the training predictors and does not read the label.

\end{document}
