<<failures, results="asis">>=
if (nrow(failed) == 0) {
  cat("Every model and arm produced a finite test score on every split.\n")
} else {
  cat("Some cells did not produce a score.\n")
  cat("\\begin{verbatim}\n")
  lines <- sprintf(
    "%s, %s, seed %s (%s): %s",
    failed$model_name, failed$arm, failed$seed, failed$status, failed$detail
  )
  cat(paste(lines, collapse = "\n"))
  cat("\n\\end{verbatim}\n")
}
@

The penalised GAM puts \texttt{s(x, k = 5)} on each of the 11 measurements, with \texttt{select = TRUE} and REML, and no grid.
REML chooses the smoothness inside each fit on the likelihood, so balanced accuracy is not used to pick how wiggly a term is.
Balanced accuracy places only the cut-off, from the out-of-fold probabilities.
The same five splits are used.
The radial SVM and the random forest, both with no resampling, are rerun through that 10 by 10 at their stored hyperparameters.
A seed is stacked only when both reruns match the stored test metrics within \(10^{-9}\).

<<gam-stack, include=FALSE>>=
gam_index <- expand.grid(arm = c("weights", "none"), seed = 2021:2025, stringsAsFactors = FALSE)
gam_index <- gam_index[order(gam_index$arm, gam_index$seed), ]
gam_fits <- lapply(seq_len(nrow(gam_index)), function(i) {
  readRDS(sprintf("%s/gam__%s__%d.rds", results_dir, gam_index$arm[[i]], gam_index$seed[[i]]))
})
edf_long <- do.call(rbind, lapply(seq_len(nrow(gam_index)), function(i) {
  edf <- gam_fits[[i]]$metrics$edf[[1]]
  data.frame(
    arm = gam_index$arm[[i]],
    seed = gam_index$seed[[i]],
    term = names(edf),
    edf = as.numeric(edf),
    stringsAsFactors = FALSE
  )
}))
term_order <- names(gam_fits[[1]]$metrics$edf[[1]])
edf_wide <- function(arm_name) {
  sub <- edf_long[edf_long$arm == arm_name, ]
  columns <- lapply(2021:2025, function(seed) {
    vals <- sub$edf[sub$seed == seed]
    names(vals) <- sub$term[sub$seed == seed]
    vals[term_order]
  })
  mat <- do.call(cbind, columns)
  shown <- data.frame(Term = term_order, stringsAsFactors = FALSE)
  for (j in seq_len(ncol(mat))) {
    shown[[as.character(2020 + j)]] <- sprintf("%.3f", mat[, j])
  }
  shown$Mean <- sprintf("%.3f", rowMeans(mat))
  shown
}
partial_one <- function(arm_name) {
  rows <- gam_index$arm == arm_name
  dat <- do.call(rbind, lapply(which(rows), function(i) {
    piece <- gam_fits[[i]]$partial
    piece$seed <- gam_index$seed[[i]]
    piece
  }))
  dat <- dat[order(dat$term, dat$seed, dat$x), ]
  dat$term <- factor(dat$term, levels = term_order)
  dat
}
draw_partial <- function(arm_name) {
  ggplot(partial_one(arm_name), aes(x, contribution, group = factor(seed), colour = factor(seed))) +
    geom_hline(yintercept = 0, linewidth = 0.2) +
    geom_line(linewidth = 0.3) +
    facet_wrap(~ term, scales = "free", ncol = 3) +
    labs(x = NULL, y = "Link-scale contribution", colour = "Seed") +
    theme_bw() +
    theme(legend.position = "bottom")
}
gam_mean <- function(arm_name) {
  rows <- lapply(which(gam_index$arm == arm_name), function(i) gam_fits[[i]]$metrics)
  bound <- dplyr::bind_rows(rows)
  bound <- bound[order(bound$seed), ]
  c(
    ba = mean(bound$bal_accuracy),
    roc = mean(bound$roc_auc),
    pr = mean(bound$pr_auc)
  )
}
stack_fits <- lapply(2021:2025, function(seed) readRDS(sprintf("%s/stack__%d.rds", results_dir, seed)))
average_fits <- lapply(2021:2025, function(seed) readRDS(sprintf("%s/average__%d.rds", results_dir, seed)))
decision <- readRDS(file.path(results_dir, "stack_decision.rds"))
run_gs <- readRDS(file.path(results_dir, "run_gam_stack.rds"))
rerun_rows <- lapply(c("svm_radial", "rf"), function(model) {
  lapply(2021:2025, function(seed) {
    r <- readRDS(sprintf("%s/oof_rerun/%s__none__%d.rds", results_dir, model, seed))
    data.frame(model = model, seed = seed, pass = isTRUE(r$pass), stringsAsFactors = FALSE)
  })
})
rerun_rows <- do.call(rbind, unlist(rerun_rows, recursive = FALSE))
seeds_stacked <- sum(tapply(rerun_rows$pass, rerun_rows$seed, all))
svm_ref <- metrics %>%
  dplyr::filter(model == "svm_radial", arm == "none") %>%
  dplyr::arrange(seed)
if (!identical(svm_ref$seed, 2021:2025)) stop("Radial SVM rows are not in seed order")
if (!identical(as.integer(decision$seeds), 2021:2025)) stop("Stack decision is not in seed order")
mean_or_na <- function(fits, column) {
  vals <- vapply(fits, function(item) {
    if (!identical(item$status, "ok")) return(NA_real_)
    item$metrics[[column]][[1]]
  }, numeric(1))
  mean(vals)
}
stack_means <- c(
  ba = mean_or_na(stack_fits, "bal_accuracy"),
  roc = mean_or_na(stack_fits, "roc_auc"),
  pr = mean_or_na(stack_fits, "pr_auc")
)
average_means <- c(
  ba = mean_or_na(average_fits, "bal_accuracy"),
  roc = mean_or_na(average_fits, "roc_auc"),
  pr = mean_or_na(average_fits, "pr_auc")
)
svm_means <- c(
  ba = mean(svm_ref$bal_accuracy),
  roc = mean(svm_ref$roc_auc),
  pr = mean(svm_ref$pr_auc)
)
gam_weights_means <- gam_mean("weights")
gam_none_means <- gam_mean("none")
@

